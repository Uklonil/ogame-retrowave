/* =========================================================
       VERITATE RETROWAVE — DESIGN TOKENS
       ========================================================= */

    :root {
        --rw-void: #050510;
        --rw-space: #080a18;

        --rw-panel: #0d1022;
        --rw-panel-2: #12162c;
        --rw-panel-hover: #191e39;

        --rw-cyan: #31e7ff;
        --rw-cyan-soft: #78efff;

        --rw-magenta: #ff3cac;
        --rw-pink: #ff71ce;

        --rw-purple: #8b5cf6;
        --rw-violet: #5634a5;

        --rw-yellow: #ffe66d;
        --rw-green: #62ff9d;
        --rw-red: #ff5277;

        --rw-text: #e7e9ff;
        --rw-muted: #8990b5;

        --rw-border:
            rgba(49, 231, 255, .32);

        --rw-border-hot:
            rgba(255, 60, 172, .65);

        --rw-glow-cyan:
            0 0 4px rgba(49, 231, 255, .45),
            0 0 12px rgba(49, 231, 255, .12);

        --rw-glow-magenta:
            0 0 5px rgba(255, 60, 172, .55),
            0 0 14px rgba(255, 60, 172, .15);

        --rw-gradient:
            linear-gradient(
                90deg,
                var(--rw-cyan),
                var(--rw-purple),
                var(--rw-magenta)
            );
    }


    /* =========================================================
       SPACE / PAGE
       ========================================================= */

    html,
    body,
    #ingamepage {
        background-color: var(--rw-void) !important;
    }

    body#ingamepage {
        background-color:
            var(--rw-void) !important;

        background-image:
            linear-gradient(
                90deg,
                rgba(3, 4, 14, .38) 0%,
                rgba(3, 4, 14, .28) 38%,
                rgba(3, 4, 14, .08) 70%,
                rgba(3, 4, 14, .02) 100%
            ),
            url("data:image/png;base64,") !important;

        background-position:
            center top !important;

        background-size:
            cover !important;

        background-repeat:
            no-repeat !important;

        background-attachment:
            fixed !important;

        color:
            var(--rw-text);
    }


    /* =========================================================
       MAIN OGame WRAPPER
       ========================================================= */

    #pageContent,
    #contentWrapper,
    #content,
    #middle,
    #overviewcomponent,
    #inhalt {
        background-color: transparent !important;
    }


    /* =========================================================
       LINKS
       ========================================================= */

    a {
        color: var(--rw-cyan-soft);
    }

    a:hover {
        color: var(--rw-pink);
        text-shadow: var(--rw-glow-magenta);
    }


    /* =========================================================
       OVERVIEW — PLANET
       ========================================================= */

    #planet {
        border:
            1px solid rgba(49, 231, 255, .35) !important;

        box-shadow:
            0 0 15px rgba(49, 231, 255, .08),
            inset 0 0 25px rgba(5, 5, 16, .45);

        overflow: hidden;
    }


    /*
     * Retain planet artwork but tint the information area.
     */

    #detailWrapper {
        background:
            linear-gradient(
                90deg,
                rgba(8, 10, 24, .35),
                rgba(13, 16, 34, .86)
            ) !important;
    }


    /* Planet title */

    #header_text h2,
    #header_text h2 a,
    #planetNameHeader,
    .planetNameOverview {
        color: var(--rw-text) !important;
        text-shadow:
            0 0 5px rgba(49, 231, 255, .4);
    }


    #planetNameHeader {
        color: var(--rw-cyan) !important;
    }


    /* =========================================================
       OVERVIEW PRODUCTION CARDS
       ========================================================= */

    #productionboxBottom .content-box-s {
        background:
            linear-gradient(
                180deg,
                rgba(18, 22, 44, .97),
                rgba(8, 10, 24, .98)
            ) !important;

        border:
            1px solid var(--rw-border) !important;

        box-shadow:
            inset 0 1px rgba(255, 255, 255, .025),
            0 0 8px rgba(49, 231, 255, .06);

        border-radius: 2px;
    }


    #productionboxBottom .content-box-s .header {
        background:
            linear-gradient(
                90deg,
                rgba(49, 231, 255, .13),
                rgba(139, 92, 246, .10),
                rgba(255, 60, 172, .10)
            ) !important;

        border-bottom:
            1px solid var(--rw-border) !important;
    }


    #productionboxBottom .content-box-s .header h3 {
        color: var(--rw-cyan) !important;

        text-shadow:
            0 0 5px rgba(49, 231, 255, .3);

        letter-spacing: .3px;
    }


    #productionboxBottom .content-box-s .content {
        background:
            rgba(7, 9, 20, .88) !important;

        color: var(--rw-text) !important;
    }


    #productionboxBottom td {
        background: transparent !important;
        color: var(--rw-text) !important;
    }


    #productionboxBottom td.idle a {
        color: var(--rw-muted) !important;
    }


    #productionboxBottom td.idle a:hover {
        color: var(--rw-cyan) !important;
    }


    /* =========================================================
       RESOURCES
       ========================================================= */

    #resourcesbarcomponent {
        filter:
            drop-shadow(
                0 0 5px rgba(49, 231, 255, .10)
            );
    }


    /* Resource quantities */

    #resourcesbarcomponent .value {
        color: var(--rw-text) !important;
        text-shadow:
            0 0 3px rgba(49, 231, 255, .25);
    }


    /* =========================================================
       PLANET LIST
       ========================================================= */

    #rechts,
    #myWorlds,
    #planetList {
        background-color:
            transparent !important;
    }


    #countColonies {
        color: var(--rw-muted) !important;

        border-bottom:
            1px solid var(--rw-border) !important;
    }


    #planetList .smallplanet {
        transition:
            filter .15s ease,
            transform .15s ease;
    }


    #planetList .smallplanet:hover {
        filter:
            drop-shadow(
                0 0 6px rgba(255, 60, 172, .5)
            );

        transform:
            translateX(-2px);
    }


    /* =========================================================
       GENERIC CONTENT BOXES
       ========================================================= */

    .content-box-s,
    .content-box-m,
    .content-box-l,
    .content-box-xl {
        color: var(--rw-text);
    }


    .content-box-s .header,
    .content-box-m .header,
    .content-box-l .header,
    .content-box-xl .header {
        color: var(--rw-cyan);
    }


    /* =========================================================
       FORMS
       ========================================================= */

    input,
    select,
    textarea {
        background:
            var(--rw-space) !important;

        color:
            var(--rw-text) !important;

        border:
            1px solid var(--rw-border) !important;
    }


    input:focus,
    select:focus,
    textarea:focus {
        border-color:
            var(--rw-cyan) !important;

        box-shadow:
            var(--rw-glow-cyan);

        outline:
            none !important;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    button,
    .btn,
    input[type="button"],
    input[type="submit"] {
        background:
            linear-gradient(
                180deg,
                #171c37,
                #0b0e20
            ) !important;

        color:
            var(--rw-cyan) !important;

        border:
            1px solid var(--rw-border) !important;

        transition:
            border-color .15s ease,
            color .15s ease,
            box-shadow .15s ease;
    }


    button:hover,
    .btn:hover,
    input[type="button"]:hover,
    input[type="submit"]:hover {
        color:
            var(--rw-pink) !important;

        border-color:
            var(--rw-border-hot) !important;

        box-shadow:
            var(--rw-glow-magenta);
    }


    /* =========================================================
       TABLES
       ========================================================= */

    table {
        color:
            var(--rw-text);
    }


    th {
        color:
            var(--rw-cyan) !important;
    }


    tr:hover td {
        background-color:
            rgba(49, 231, 255, .035) !important;
    }


    /* =========================================================
       STATUS COLORS
       ========================================================= */

    .positive,
    .success {
        color:
            var(--rw-green) !important;
    }


    .negative,
    .error {
        color:
            var(--rw-red) !important;
    }


    .warning {
        color:
            var(--rw-yellow) !important;
    }


    /* =========================================================
       SCROLLBAR — Chromium
       ========================================================= */

    ::-webkit-scrollbar {
        width: 9px;
        height: 9px;
    }


    ::-webkit-scrollbar-track {
        background:
            var(--rw-void);
    }


    ::-webkit-scrollbar-thumb {
        background:
            linear-gradient(
                180deg,
                var(--rw-purple),
                var(--rw-magenta)
            );

        border:
            2px solid var(--rw-void);

        border-radius:
            6px;
    }


    ::selection {
        background:
            rgba(255, 60, 172, .35);

        color:
            #fff;
    }
/* =========================================================
   VERITATE RETROWAVE v0.3
   NAVIGATION + HUD
   ========================================================= */


/* =========================================================
   TOP USER BAR
   ========================================================= */

#bar {
    background:
        linear-gradient(
            180deg,
            rgba(14, 17, 38, .98),
            rgba(6, 8, 20, .98)
        ) !important;

    border-bottom:
        1px solid rgba(49, 231, 255, .28) !important;

    box-shadow:
        0 2px 12px rgba(49, 231, 255, .06);
}


#bar a {
    color:
        var(--rw-cyan-soft) !important;

    transition:
        color .15s ease,
        text-shadow .15s ease;
}


#bar a:hover {
    color:
        var(--rw-pink) !important;

    text-shadow:
        var(--rw-glow-magenta);
}


/* Player name */

#bar .playername,
#bar .textBeefy {
    color:
        var(--rw-text) !important;
}


/* =========================================================
   LEFT MENU — v0.3.1
   ========================================================= */

#left {
    background:
        linear-gradient(
            180deg,
            rgba(11, 14, 30, .97),
            rgba(5, 7, 17, .99)
        ) !important;

    border:
        1px solid rgba(49, 231, 255, .14);

    box-shadow:
        inset 0 0 35px rgba(49, 231, 255, .025);
}


/* ---------------------------------------------------------
   MENU ROW
   --------------------------------------------------------- */

#menuTable > li {
    position: relative;

    filter:
        saturate(.72)
        brightness(.88);

    transition:
        filter .15s ease;
}


/* Vertical accent line */

#menuTable > li::before {
    content: "";

    position: absolute;

    left: 0;
    top: 2px;
    bottom: 2px;

    width: 2px;

    background:
        var(--rw-cyan);

    opacity: 0;

    box-shadow:
        0 0 7px rgba(49, 231, 255, .65);

    transition:
        opacity .15s ease;
}


/* ---------------------------------------------------------
   TEXT BUTTON
   --------------------------------------------------------- */

#menuTable a.menubutton {
    position: relative;

    color:
        #929dbf !important;

    transition:
        color .15s ease,
        text-shadow .15s ease,
        background-color .15s ease;
}


#menuTable a.menubutton .textlabel {
    color:
        inherit !important;

    transition:
        color .15s ease,
        text-shadow .15s ease;
}


/* ---------------------------------------------------------
   HOVER
   --------------------------------------------------------- */

#menuTable > li:hover {
    filter:
        saturate(.95)
        brightness(1.02);
}


#menuTable > li:hover::before {
    opacity: .85;
}


#menuTable > li:hover a.menubutton {
    color:
        var(--rw-cyan) !important;

    text-shadow:
        0 0 5px rgba(49, 231, 255, .42);

    background:
        linear-gradient(
            90deg,
            rgba(49, 231, 255, .10),
            transparent 80%
        ) !important;
}


/* Icon gets a softer treatment */

#menuTable > li:hover .menu_icon {
    filter:
        brightness(1.16)
        saturate(1.15)
        drop-shadow(
            0 0 3px rgba(49, 231, 255, .30)
        );
}


/* ---------------------------------------------------------
   ACTIVE PAGE
   --------------------------------------------------------- */

#menuTable > li:has(a.menubutton.selected) {
    filter:
        saturate(1)
        brightness(1.08);
}


#menuTable > li:has(a.menubutton.selected)::before {
    opacity: 1;

    background:
        var(--rw-magenta);

    box-shadow:
        0 0 8px rgba(255, 60, 172, .7);
}


#menuTable a.menubutton.selected {
    color:
        var(--rw-pink) !important;

    text-shadow:
        0 0 5px rgba(255, 60, 172, .45);

    background:
        linear-gradient(
            90deg,
            rgba(255, 60, 172, .13),
            rgba(139, 92, 246, .05),
            transparent 80%
        ) !important;
}


#menuTable a.menubutton.selected .textlabel {
    color:
        var(--rw-pink) !important;
}


/* Active icon */

#menuTable > li:has(a.menubutton.selected) .menu_icon {
    filter:
        brightness(1.15)
        saturate(1.2)
        drop-shadow(
            0 0 4px rgba(255, 60, 172, .32)
        );
}


/* ---------------------------------------------------------
   PREMIUM / SPECIAL
   --------------------------------------------------------- */

#menuTable a.menubutton.premiumHighligt,
#menuTable a.menubutton.premiumHighligt .textlabel {
    color: var(--rw-yellow) !important;

    text-shadow:
        0 0 4px rgba(255, 230, 109, .28);
}


#menuTable a.menubutton.premiumHighligt:hover {
    color:
        #fff0a3 !important;

    text-shadow:
        0 0 6px rgba(255, 230, 109, .45);
}


/* =========================================================
   RESOURCES HUD
   ========================================================= */

#resourcesbarcomponent {
    position:
        relative;

    background:
        linear-gradient(
            180deg,
            rgba(14, 17, 38, .82),
            rgba(5, 8, 20, .72)
        ) !important;

    border-bottom:
        1px solid rgba(49, 231, 255, .18);
}


#resourcesbarcomponent li {
    transition:
        filter .15s ease,
        transform .15s ease;
}


#resourcesbarcomponent li:hover {
    filter:
        brightness(1.2)
        saturate(1.15);

    transform:
        translateY(-1px);
}


/*
 * Resource values
 */

#resourcesbarcomponent .value {
    color:
        var(--rw-text) !important;

    font-weight:
        600;

    text-shadow:
        0 0 4px rgba(49, 231, 255, .2);
}


/* Metal */

#resourcesbarcomponent #metal_box .value,
#resourcesbarcomponent .metal .value {
    color:
        #d2d8e8 !important;
}


/* Crystal */

#resourcesbarcomponent #crystal_box .value,
#resourcesbarcomponent .crystal .value {
    color:
        var(--rw-cyan) !important;
}


/* Deuterium */

#resourcesbarcomponent #deuterium_box .value,
#resourcesbarcomponent .deuterium .value {
    color:
        #aa86ff !important;
}


/* Energy */

#resourcesbarcomponent #energy_box .value,
#resourcesbarcomponent .energy .value {
    color:
        var(--rw-yellow) !important;
}


/* Dark Matter */

#resourcesbarcomponent #darkmatter_box .value,
#resourcesbarcomponent .darkmatter .value {
    color:
        var(--rw-pink) !important;
}


/* =========================================================
   EVENT / FLEET BAR
   ========================================================= */

#eventboxContent,
#eventboxFilled,
#eventboxBlank {
    background-color:
        rgba(7, 9, 21, .9) !important;

    border-color:
        var(--rw-border) !important;
}


#eventboxContent a {
    color:
        var(--rw-cyan-soft) !important;
}


#eventboxContent a:hover {
    color:
        var(--rw-pink) !important;
}


/* =========================================================
   RIGHT PLANET SELECTOR
   ========================================================= */

#rechts {
    color:
        var(--rw-text) !important;
}


#countColonies {
    background:
        linear-gradient(
            90deg,
            rgba(49, 231, 255, .06),
            rgba(139, 92, 246, .05)
        ) !important;

    color:
        var(--rw-muted) !important;

    border:
        1px solid rgba(49, 231, 255, .18) !important;
}


#countColonies span {
    color:
        var(--rw-cyan) !important;
}


#planetList .smallplanet {
    border:
        1px solid transparent;

    border-radius:
        3px;
}


#planetList .smallplanet:hover {
    border-color:
        rgba(255, 60, 172, .45);

    background-color:
        rgba(255, 60, 172, .035);

    box-shadow:
        0 0 10px rgba(255, 60, 172, .10);
}


/* Planet name */

#planetList .planet-name,
#planetList .planet-name:link,
#planetList .planet-name:visited {
    color:
        var(--rw-text) !important;
}


/* Coordinates */

#planetList .planet-koords {
    color:
        var(--rw-cyan) !important;
}


/* =========================================================
   OVERVIEW — STRONGER FRAME
   ========================================================= */

#planet {
    border-color:
        rgba(49, 231, 255, .48) !important;

    box-shadow:
        0 0 0 1px rgba(139, 92, 246, .08),
        0 0 16px rgba(49, 231, 255, .075),
        inset 0 0 32px rgba(5, 5, 16, .38);
}


/*
 * Thin synthwave accent under planet title
 */

#header_text {
    position:
        relative;
}


#header_text::after {
    content: "";

    position:
        absolute;

    left:
        0;

    right:
        0;

    bottom:
        -2px;

    height:
        1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--rw-cyan),
            var(--rw-purple),
            var(--rw-magenta),
            transparent
        );

    opacity:
        .55;
}


/* =========================================================
   PRODUCTION BOX — SMALL POLISH
   ========================================================= */

#productionboxBottom .content-box-s {
    transition:
        border-color .15s ease,
        box-shadow .15s ease,
        transform .15s ease;
}


#productionboxBottom .content-box-s:hover {
    border-color:
        rgba(255, 60, 172, .38) !important;

    box-shadow:
        0 0 10px rgba(255, 60, 172, .08),
        inset 0 1px rgba(255, 255, 255, .025);

    transform:
        translateY(-1px);
}

/* =========================================================
   TOOLTIPS
   ========================================================= */

.tooltip,
.tooltipHTML {
    color:
        inherit;
}


/* OGame tooltip container */

#tooltip,
.tooltipWrapper,
.tooltipContent {
    background:
        linear-gradient(
            180deg,
            rgba(15, 18, 38, .98),
            rgba(6, 8, 20, .98)
        ) !important;

    color:
        var(--rw-text) !important;

    border:
        1px solid rgba(49, 231, 255, .38) !important;

    box-shadow:
        0 0 10px rgba(49, 231, 255, .10),
        inset 0 1px rgba(255, 255, 255, .025) !important;
}


#tooltip a,
.tooltipWrapper a,
.tooltipContent a {
    color:
        var(--rw-cyan) !important;
}


#tooltip strong,
.tooltipWrapper strong,
.tooltipContent strong {
    color:
        var(--rw-pink) !important;
}
